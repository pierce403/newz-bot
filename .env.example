XMTP_WALLET_KEY=0xYOUR_PRIVATE_KEY
XMTP_GENERATED_WALLET_KEY_PATH=.data/xmtp-wallet-key
XMTP_ENV=production
XMTP_DB_DIRECTORY=.data/xmtp-agent
XMTP_DB_ENCRYPTION_KEY=
XMTP_GENERATED_DB_ENCRYPTION_KEY_PATH=.data/xmtp-db-encryption-key
DATA_DIR=.data
GDELT_API_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_DEFAULT_TIMESPAN=24h
GDELT_MAX_ARTICLES=40
GDELT_FETCH_TIMEOUT_MS=15000
HTTP_PORT=8787
LOG_LEVEL=info
